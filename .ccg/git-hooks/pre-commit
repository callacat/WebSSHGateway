#!/usr/bin/env bash
# ================================================================
# pre-commit hook — 质量门禁
# 自动检查 CHANGELOG、VERSION、安全文件变更。
# 阻塞不通过项，防止质量问题随提交混过去。
# ================================================================
set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

FAILED=0

# ── 辅助函数 ──────────────────────────────────────────────

warn()  { echo -e "${YELLOW}⚠  $1${NC}"; }
pass()  { echo -e "${GREEN}✓  $1${NC}"; }
fail()  { echo -e "${RED}✘  $1${NC}"; FAILED=1; }
info()  { echo -e "${CYAN}ℹ  $1${NC}"; }
header() { echo -e "\n${BOLD}$1${NC}"; }

# ── 检测暂存区变更 ──────────────────────────────────────

STAGED_FILES=$(git diff --cached --name-only)
STAGED_SOURCE=$(echo "$STAGED_FILES" | grep -cE '\.(tsx?|jsx?|py|go|rs|c|cpp|h|hpp|java|kt|rb|sh)$' || true)
STAGED_TOTAL=$(echo "$STAGED_FILES" | wc -l)
STAGED_LINES=$(git diff --cached --numstat | awk '{added+=$1} END {print added+0}')

# ── 安全敏感文件模式 ──────────────────────────────────────

SECURITY_PATTERNS=(
  'auth'
  'crypto'
  'password'
  'token'
  'secret'
  'encrypt'
  'sanitize'
  'injection'
  'permission'
  'session'
)

SECURITY_HIT=$(
  echo "$STAGED_FILES" | grep -iE "$(IFS='|'; echo "${SECURITY_PATTERNS[*]}")" || true
)

SKIP_BYPASS=$(git commit --allow-empty -n 2>/dev/null; echo "noop")

# ════════════════════════════════════════════════════════════
# 检查 1: CHANGELOG 更新
# ════════════════════════════════════════════════════════════

header "📋 [1/4] CHANGELOG 同步检查"

if echo "$STAGED_FILES" | grep -q 'CHANGELOG\.md'; then
  if git diff --cached CHANGELOG.md | grep -q '## \[Unreleased\]'; then
    pass "CHANGELOG.md [Unreleased] 节已更新"
  else
    fail "CHANGELOG.md 有变更但缺少 [Unreleased] 节"
    info "请先在 CHANGELOG.md 的 [Unreleased] 下记录本次变更摘要"
  fi
elif [ "$STAGED_SOURCE" -gt 0 ]; then
  fail "有源码变更但 CHANGELOG.md 未暂存"
  info "运行: git add CHANGELOG.md（或用 --no-verify 跳过，不推荐）"
else
  pass "无源码变更，跳过 CHANGELOG 检查"
fi

# ════════════════════════════════════════════════════════════
# 检查 2: VERSION 推进
# ════════════════════════════════════════════════════════════

header "📋 [2/4] VERSION 推进检查"

if echo "$STAGED_FILES" | grep -q '^VERSION$'; then
  OLD_VERSION=$(git show HEAD:VERSION 2>/dev/null || echo "0.0.0")
  NEW_VERSION=$(cat VERSION 2>/dev/null || echo "")
  if [ -z "$NEW_VERSION" ]; then
    fail "VERSION 文件为空"
  elif [ "$NEW_VERSION" = "$OLD_VERSION" ]; then
    fail "VERSION 被暂存但内容未改变（$OLD_VERSION）"
    info "如果是 feat → MINOR+1, fix → PATCH+1, breaking → MAJOR+1"
  else
    pass "VERSION: $OLD_VERSION → $NEW_VERSION"
  fi
elif [ "$STAGED_SOURCE" -gt 0 ]; then
  fail "有源码变更但 VERSION 未暂存"
  info "运行: git add VERSION（或用 --no-verify 跳过，不推荐）"
else
  pass "无源码变更，跳过 VERSION 检查"
fi

# ════════════════════════════════════════════════════════════
# 检查 3: 提交信息格式预告
# ════════════════════════════════════════════════════════════

header "📋 [3/4] 提交信息格式提醒"

COMMIT_MSG_FILE=.git/COMMIT_EDITMSG
if [ -f "$COMMIT_MSG_FILE" ]; then
  FIRST_LINE=$(head -1 "$COMMIT_MSG_FILE")
  if echo "$FIRST_LINE" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\([^)]+\))?!?:\ '; then
    pass "Commit 首行格式符合 Conventional Commits: ${FIRST_LINE:0:60}…"
  else
    warn "Commit 首行可能不符合 Conventional Commits 格式"
    info "正确格式: feat(scope): subject  或  fix: subject  等"
    info "类型: feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert"
  fi
fi

# ════════════════════════════════════════════════════════════
# 检查 4: 安全相关文件警告
# ════════════════════════════════════════════════════════════

header "📋 [4/4] 安全敏感变更检查"

HAS_VERIFY_SECURITY_MARKER=$(git diff --cached | grep -cE 'verify-security|\[security-reviewed\]' || true)

if [ -n "$SECURITY_HIT" ] && [ "$HAS_VERIFY_SECURITY_MARKER" -eq 0 ]; then
  warn "以下暂存文件匹配安全敏感模式："
  echo "$SECURITY_HIT" | while read -r f; do echo "    - $f"; done
  info "提交后建议运行: /verify-security"
  info "如已审查，在 commit body 中添加 [security-reviewed] 以消除此提醒"
else
  pass "未检测到安全敏感变更或已有审查标记"
fi

# ════════════════════════════════════════════════════════════
# 汇总
# ════════════════════════════════════════════════════════════

header "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
if [ "$FAILED" -ne 0 ]; then
  echo -e "\n${RED}${BOLD}✘  ${FAILED} 项检查未通过。${NC}"
  echo -e "${YELLOW}请修复后重新暂存并提交，或用 --no-verify 强制提交（不推荐）。${NC}\n"
  exit 1
else
  echo -e "\n${GREEN}${BOLD}✓  所有检查通过。${NC}\n"
  exit 0
fi
