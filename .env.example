# Backend configuration
# SECRET_KEY: must be exactly 16/24/32 BYTES. Note the quick-generate commands below
#   emit 32 random bytes as a 64-char hex string (64 chars = 32 bytes), which is the
#   recommended length. Replace the example below with your own value.
#   Quick generate (pick one, all output 64 hex chars = 32 bytes):
#     openssl rand -hex 32
#     python3 -c 'import secrets; print(secrets.token_hex(32))'
#     head -c 32 /dev/urandom | xxd -p -c 64
SECRET_KEY=c8ab6d4eb00de6a5597f8f7423a6cfff2bcfc5d992a06957df3aab23ea2abcf7
DATABASE_URL=sqlite:////data/app.db
PORT=8080
LOG_LEVEL=INFO
SESSION_KEEPALIVE_INTERVAL=60
JWT_ISSUER=webssh-gateway
JWT_ACCESS_TTL_HOURS=12
JWT_REMEMBER_TTL_DAYS=7
LOGIN_LOCK_MINUTES=15
LOGIN_LOCK_THRESHOLD=5
SSH_KNOWN_HOSTS=/data/known_hosts
SSH_ALLOW_UNKNOWN_HOSTS=false
SSH_AUTO_ADD_KNOWN_HOSTS=true
CORS_ALLOW_ORIGINS=

# Frontend (dev only)
VITE_API_BASE=http://localhost:8080
